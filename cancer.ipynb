    "from tensorflow.keras.models import load_model\n",
    "from tensorflow.keras.preprocessing import image\n",
    "import numpy as np\n",
    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "import time\n",
    "\n",
    "# Load the model\n",
    "model = load_model('breast_cancer_diagnosis_model.h5')\n",
    "\n",
    "def preprocess_image(img_path, target_size=(150, 150)):\n",
    "    \"\"\"Preprocesses an image for model prediction.\"\"\"\n",
    "    try:\n",
    "        img = image.load_img(img_path, target_size=target_size)\n",
    "        img_array = image.img_to_array(img)\n",
    "        img_array = np.expand_dims(img_array, axis=0)\n",
    "        img_array /= 255.0\n",
    "        return img_array\n",
    "    except Exception as e:\n",
    "        print(f\"Error preprocessing image {img_path}: {e}\")\n",
    "        return None\n",
    "\n",
    "def predict_cancer(model, img_array):\n",
    "    \"\"\"Predicts cancer type using the loaded model.\"\"\"\n",
    "    if img_array is not None:\n",
    "        try:\n",
    "            prediction = model.predict(img_array)\n",
    "            return prediction\n",
    "        except Exception as e:\n",
    "            print(f\"Error during prediction: {e}\")\n",
    "            return None\n",
    "    return None\n",
    "\n",
    "def interpret_prediction(prediction):\n",
    "    \"\"\"Interprets the model prediction based on confidence thresholds.\"\"\"\n",
    "    if prediction is not None:\n",
    "        probabilities = prediction[0]\n",
    "        max_prob = np.max(probabilities)\n",
    "\n",
    "        if max_prob < 0.20:\n",
    "            label = 'normal'\n",
    "            confidence = probabilities[0] if len(probabilities) > 0 else 0.0 # handle potential index error\n",
    "        elif max_prob < 0.50:\n",
    "            label = 'benign'\n",
    "            confidence = probabilities[0] if len(probabilities) > 0 else 0.0 # handle potential index error\n",
    "        else:\n",
    "            label = 'malignant'\n",
    "            confidence = probabilities[0] if len(probabilities) > 0 else 0.0 # handle potential index error\n",
    "\n",
    "        return label, confidence\n",
    "    return None, None\n",
    "\n",
    "def visualize_prediction(image_file, label, confidence, processing_time):\n",
    "    \"\"\"Visualizes the prediction results with a single bar and additional information.\"\"\"\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    plt.bar(label, confidence)\n",
    "    plt.xlabel('Class')\n",
    "    plt.ylabel('Probability')\n",
    "    plt.title(f'Prediction for {image_file}\\nPredicted: {label} (Confidence: {confidence:.4f})\\nProcessing Time: {processing_time:.4f} seconds')\n",
    "    plt.ylim(0, 1)\n",
    "    plt.text(0.5, -0.15, f\"Image File: {image_file}\\nPredicted Class: {label}\\nConfidence: {confidence:.4f}\\nProcessing Time: {processing_time:.4f} seconds\", ha='center', va='center', transform=plt.gca().transAxes)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def run_prediction_and_display(model, test_directory):\n",
    "    \"\"\"Runs prediction on all images in the test directory and displays results.\"\"\"\n",
    "    image_files = [f for f in os.listdir(test_directory) if f.lower().endswith(('.png', '.jpg', '.jpeg'))]\n",
    "\n",
    "    if not image_files:\n",
    "        print(f\"No image files found in {test_directory}\")\n",
    "        return\n",
    "\n",
    "    print(\"Starting prediction process...\")\n",
    "    for image_file in image_files:\n",
    "        image_path = os.path.join(test_directory, image_file)\n",
    "        start_time = time.time()\n",
    "        img_array = preprocess_image(image_path)\n",
    "        prediction = predict_cancer(model, img_array)\n",
    "        label, confidence = interpret_prediction(prediction)\n",
    "        end_time = time.time()\n",
    "        processing_time = end_time - start_time\n",
    "\n",
    "        if label:\n",
    "            print(f\"Image: {image_file} - Predicted: {label} (Confidence: {confidence:.4f}) - Time: {processing_time:.4f}s\")\n",
    "            visualize_prediction(image_file, label, confidence, processing_time)\n",
    "        else:\n",
    "            print(f\"Error processing {image_file}.\")\n",
    "        print(\"-\" * 40)\n",
    "    print(\"Prediction process completed.\")\n",
    "\n",
    "# Example usage\n",
    "test_directory = r'C:\\Users\\sagar\\OneDrive\\Desktop\\test' #change to your path.\n",
    "run_prediction_and_display(model, test_directory)"
   ]
  }
